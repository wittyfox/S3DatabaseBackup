{
  "name": "wittyfox/s3-backup",
  "description": "Simple S3 backup for a laravel project",
  "authors": [
    {
      "name": "Jovan Haji-Djurich",
      "email": "wittyfoxcodes@gmail.com"
    }
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "league/flysystem-aws-s3-v3": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "WittyFox\\S3\\": "src"
    },
    "classmap": [
      "config/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WittyFox\\S3\\Tests\\": "tests"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0|^11.0|^12.0",
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "laravel/pint": "^1.5"
  },
  "suggest": {
    "ext-zlib": "Required when s3backup.gzip is enabled (the default)."
  },
  "extra": {
    "laravel": {
      "providers": [
        "WittyFox\\S3\\S3BackupServiceProvider"
      ]
    }
  }
}
